<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.prcp.business.data.basic.mapper.BasicDataMapper">

    <update id="updateByDynamic">
        UPDATE prcp_data_basic
        SET ${columns}, updated_at = NOW()
        WHERE id = #{id}
    </update>

    <insert id="insertByDynamic">
        INSERT INTO prcp_data_basic (data_date, coa_node_id, ${columns})
        VALUES (#{dataDate}, #{nodeId}, #{values})
    </insert>

    <delete id="deleteById">
        DELETE FROM prcp_data_basic WHERE id = #{id}
    </delete>
</mapper>
